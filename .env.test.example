# .env.test — Test environment variables
# Used by Docker Compose for test runs (`make test` / `.\Makefile.ps1 test`)
# Passed via --env-file and bind-mounted into the test container as /app/src/.env
#
# NEVER commit this file to git. Use .env.test.example as the template.

# ====================== Django ======================
DJANGO_SECRET_KEY=test-secret-key-for-testing-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ====================== PostgreSQL Database ======================
POSTGRES_USER=postgres
POSTGRES_DB=mko_bazuna
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db

# ====================== Redis ======================
REDIS_URL=

# ====================== Telegram Bot ======================
BOT_USERNAME=test-bot
BOT_TOKEN=test-bot-token-for-testing

# ====================== Google Cloud Translation API ======================
# Empty — translations fall back to original text in test. Override with a real
# key only if you need active translation.
GOOGLE_TRANSLATE_API_KEY=

# ====================== Admin User ======================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test-admin-password
ADMIN_TELEGRAM_ID=-1

# ====================== Seed (demo data) ======================
SEED_USERS=2
SEED_ADS=10

# ====================== Public site ======================
# Site URL used for absolute links (e.g. Telegram alert messages).
# In dev: http://localhost:8000 (no trailing slash)
SITE_URL=http://localhost:8000

# Near-real-time publish-time alert delivery (Telegram). Default OFF for safe rollout.
IMMEDIATE_ALERTS_ENABLED=false

# ====================== TLS Certificates (production nginx) ======================
TLS_CERT_PATH=/etc/nginx/certs

# ====================== Analytics ======================
PLAUSIBLE_HOST=

# ====================== Container runtime ======================
FIX_PERMISSIONS=0
SKIP_ENV_CHECK=1

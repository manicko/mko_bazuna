# .env.dev — Development environment variables
# Used by Docker Compose for dev (`make up` / `.\Makefile.ps1 up`)
# Bind-mounted into containers as /app/src/.env (via Docker Compose volume mount)
#
# DO NOT include DATABASE_URL — Docker Compose constructs it from POSTGRES_* vars.
# The POSTGRES_* values below use the inter-container hostname `db`.
#
# NEVER commit this file to git. Use .env.dev.example as the template.

# ====================== Django ======================
# Generate a secure key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NOTE: Single-quote the value so Docker Compose does NOT interpolate "$VAR".
DJANGO_SECRET_KEY=<generate-with-django-secret-key-generator>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ====================== PostgreSQL Database ======================
# Compose constructs DATABASE_URL from POSTGRES_* ? postgres://user:pass@db:5432/db
POSTGRES_USER=bazuna_user
POSTGRES_DB=bazuna_db
POSTGRES_PASSWORD=<dev-db-password>
POSTGRES_HOST=db

# ====================== Redis ======================
# In Docker, use redis://redis:6379/0 (service name).
REDIS_URL=redis://redis:6379/0

# ====================== Telegram Bot ======================
# Bot username for contact deep-links (without @)
BOT_USERNAME=<your-bot-username>

# HMAC key for the Telegram-ID log mask (mask_telegram_id). Empty in dev is
# accepted: the mask falls back to a per-process random key, so values are not
# correlatable across processes. Set a shared value to correlate dev logs.
LOG_MASK_KEY=

# Get your bot token from @BotFather
# Empty = skip bot startup in dev. Real token from @BotFather if you need bot testing.
BOT_TOKEN=

# Whether THIS process must hold a BOT_TOKEN (09-API-011). Leave EMPTY — Compose
# declares it per service; empty is fail-closed (the token is still required).
BOT_TOKEN_REQUIRED=

# ====================== Email / SMTP ======================
# In dev, emails are printed to the console (EMAIL_BACKEND=console), so SMTP
# connectivity is not required. These values are not used by the console backend
# but are listed for completeness and to match the production settings schema.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
# Optional list of admin email addresses that support notifications are delivered to.
# Empty by default in dev (no support email is sent). Comma-separated.
# SUPPORT_NOTIFICATION_RECIPIENTS=admin@example.com

# ====================== Google Cloud Translation API ======================
# Dummy key for dev (satisfies prod settings guard; translations fall back to
# original text). Override with a real key only if you need active translation.
GOOGLE_TRANSLATE_API_KEY=dev-only-dummy-key-not-for-production

# ====================== Public site ======================
# Site URL used for absolute links (e.g. Telegram alert messages).
# In dev: http://localhost:8000 (no trailing slash)
SITE_URL=http://localhost:8000

# CSRF trusted origins for production settings guards (migrate, load_catalog,
# create_admin, load_cities all run with config.settings.prod in dev).
# In dev: localhost:8000 (comma-separated, no spaces)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Near-real-time publish-time alert delivery (Telegram). Default OFF for safe rollout.
IMMEDIATE_ALERTS_ENABLED=false

# ====================== Database lock timeout ======================
# Seconds any statement waits for a row/table/advisory lock before failing
# (03-DB-004). Applies to both web and bot processes. Valid range 0..2147483647;
# 0 disables the bound and is the only disabling value. A negative value is
# clamped to 0 (PostgreSQL would otherwise FATAL every process at boot).
LOCK_TIMEOUT_SECONDS=10

# ====================== TLS Certificates (production nginx) ======================
TLS_CERT_PATH=/etc/nginx/certs

# ====================== Analytics ======================
PLAUSIBLE_HOST=

# ====================== Admin User ======================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=-1

# ====================== Seed (demo data, optional seed service) ======================
SEED_USERS=10
SEED_ADS=600

# ====================== Container runtime ======================
FIX_PERMISSIONS=0
SKIP_ENV_CHECK=


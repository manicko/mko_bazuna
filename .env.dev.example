# .env.dev.example — Development environment variables template for Mko Bazuna
# Copy this file to .env.dev and fill in values for local development.
# NEVER commit .env.dev to git.
#
# Local dev runs with config.settings.dev (DEBUG=True) via the dev compose
# (docker-compose.dev.override.yml) or directly against a local Python env.

# ====================== Django ======================
# Generate a secure key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<generate-with-django-secret-key-generator>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ====================== PostgreSQL Database (Docker compose defaults) ======================
# DATABASE_URL is the single source of truth for DB config (12-factor app)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://bazuna_user:<dev-db-password>@db:5432/bazuna_db

# PostgreSQL discrete variables (used by pg_dump/pg_restore CLI tools)
POSTGRES_USER=bazuna_user
POSTGRES_DB=bazuna_db
POSTGRES_PASSWORD=<dev-db-password>

# ====================== Redis ======================
# Cache backend for rate limiting / shared cache. In dev compose REDIS_URL is set
# to empty (Redis optional); locally use redis://localhost:6379/0 if Redis is running.
REDIS_URL=redis://localhost:6379/0

# ====================== Telegram ======================
# Bot username for contact deep-links (without @)
BOT_USERNAME=<your-bot-username>

# Get your bot token from @BotFather
BOT_TOKEN=<your-bot-token-from-botfather>

# ====================== Public site ======================
# Site URL used for absolute links (e.g. Telegram alert messages).
# No trailing slash. Defaults to http://localhost:8000 when unset.
SITE_URL=http://localhost:8000

# Near-real-time publish-time alert delivery (Telegram). Default OFF for safe rollout.
# When ON, newly published ads trigger immediate per-ad Telegram messages.
IMMEDIATE_ALERTS_ENABLED=false

# ====================== Analytics ======================
# Plausible host (cookieless, no consent banner needed); empty to disable.
PLAUSIBLE_HOST=

# ====================== TLS (optional local nginx) ======================
# Only needed if running the optional nginx with HTTPS (dev nginx profile / mkcert).
TLS_CERT_PATH=/etc/nginx/certs

# ====================== Admin ======================
# Django admin/superuser (create_admin one-shot + `make create-admin`).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=-1

# ====================== Seed (demo data) ======================
# Dev compose auto-runs the seed service on `docker compose up`.
SEED_USERS=10
SEED_ADS=30

# ====================== Container runtime (docker/entrypoint.sh) ======================
# Dev bind-mounts already fix permissions when DEBUG=True; override if needed.
FIX_PERMISSIONS=0
# Set SKIP_ENV_CHECK=1 to skip the "missing .env file" fail-fast check.
SKIP_ENV_CHECK=

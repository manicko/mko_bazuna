# .env.example — Comprehensive environment variables template for Mko Bazuna
#
# Copy the appropriate template to create your .env.<tier> file:
#   cp .env.dev.example .env.dev     # development (Docker)
#   cp .env.prod.example .env.prod   # production (Docker)
#   cp .env.test.example .env.test   # testing (Docker)
#
# All .env.* files are gitignored. These .example templates are tracked in git.
#
# ====================== Django ======================
# Generate a secure key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NOTE: Single-quote the value so Docker Compose does NOT interpolate "$VAR".
DJANGO_SECRET_KEY=<generate-with-django-secret-key-generator>

# DEVELOPMENT: DEBUG=True (auto-set by docker-compose.dev.override.yml)
# PRODUCTION:  DEBUG=False (hardcoded in prod.py)
# TEST:        DEBUG=True (hardcoded in test.py)
DEBUG=False

# Comma-separated host/domain names the app can serve
# Dev:       localhost,127.0.0.1,0.0.0.0
# Prod:      your-domain.com,www.your-domain.com
# Test:      localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ====================== PostgreSQL Database ======================
# Docker Compose constructs DATABASE_URL from POSTGRES_* variables.
# DO NOT set DATABASE_URL in Docker environments.
POSTGRES_USER=bazuna_user
POSTGRES_DB=bazuna_db
POSTGRES_PASSWORD=<your-postgres-password>

# ====================== Redis ======================
# In Docker, use redis://redis:6379/0 (service name).
# Locally outside Docker, use redis://localhost:6379/0 or leave empty.
REDIS_URL=redis://redis:6379/0

# ====================== Telegram Bot ======================
# Bot username for contact deep-links (without @)
BOT_USERNAME=<your-bot-username>

# Get your bot token from @BotFather. REQUIRED in production.
BOT_TOKEN=<your-bot-token-from-botfather>

# ====================== Google Cloud Translation API (production only) ======================
# Required in production for ad content translation into ru/bs/en at publish time.
# Get a key at: https://console.cloud.google.com/apis/credentials
# Free tier: 500,000 chars/month; overages $20/1M chars.
GOOGLE_TRANSLATE_API_KEY=<your-google-cloud-translation-api-key>

# ====================== Public site ======================
# Site URL used for absolute links (e.g. Telegram alert messages). No trailing slash.
# Dev:     http://localhost:8000
# Prod:    https://mko-bazuna.example.com
SITE_URL=http://localhost:8000

# Near-real-time publish-time alert delivery (Telegram). Default OFF.
IMMEDIATE_ALERTS_ENABLED=false

# ====================== TLS Certificates (nginx) ======================
TLS_CERT_PATH=/etc/nginx/certs

# ====================== Analytics ======================
# Plausible host (cookieless, no consent banner). Empty to disable.
PLAUSIBLE_HOST=

# ====================== Error Tracking (Sentry) ======================
# Optional Sentry DSN for crash reporting. Leave empty to disable.
# Get a DSN at: https://sentry.io/organization/your-org/projects/
SENTRY_DSN=

# ====================== Admin User ======================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<your-admin-password>
ADMIN_TELEGRAM_ID=-1

# ====================== Seed (demo data) ======================
SEED_USERS=10
SEED_ADS=600

# ====================== Container image (production) ======================
REGISTRY=ghcr.io
REPOSITORY=manicko/mko_bazuna
IMAGE_TAG=latest

# ====================== Container runtime ======================
FIX_PERMISSIONS=0
SKIP_ENV_CHECK=

# .env.example — Environment variables template for Mko Bazuna
# Copy this file to .env (at the repository root, NOT inside src/backend/) and
# fill in values before starting containers. NEVER commit .env to git.
#
# For Docker deployments prefer .env.docker.example (the compose runtime file).

# ====================== Django ======================
# Generate a secure key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<generate-with-django-secret-key-generator>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ====================== PostgreSQL Database ======================
# DATABASE_URL is automatically constructed from POSTGRES_* variables in Docker containers.
# DO NOT set DATABASE_URL here - Docker Compose builds it from POSTGRES_* variables.
#
# If running Django locally (outside Docker), you can optionally set DATABASE_URL:
# DATABASE_URL=postgres://bazuna_user:your-password@localhost:5432/bazuna_db
#
# For Docker deployments, the compose files build DATABASE_URL from POSTGRES_* below.

# PostgreSQL discrete variables (used by pg_dump/pg_restore CLI tools and Docker)
POSTGRES_USER=bazuna_user
POSTGRES_DB=bazuna_db
POSTGRES_PASSWORD=your-password

# ====================== Redis ======================
# Cache backend (for rate limiting and shared cache across processes)
# In Docker, use redis://redis:6379/0 (service name).
# Locally (outside Docker), use redis://localhost:6379/0 (or omit if not running Redis).
REDIS_URL=redis://localhost:6379/0

# ====================== Telegram ======================
# Bot username for contact deep-links (without @)
BOT_USERNAME=<your-bot-username>

# Get your bot token from @BotFather. Required (non-empty) in production.
BOT_TOKEN=<your-bot-token-from-botfather>

# ====================== Public site ======================
# Site URL used for absolute links (e.g. Telegram alert messages).
# Required in production under config.settings.prod (a guard fails otherwise).
# No trailing slash. Example: https://mko-bazuna.example.com
SITE_URL=https://mko-bazuna.example.com

# Near-real-time publish-time alert delivery (Telegram). Default OFF for safe rollout.
# When ON, newly published ads trigger immediate per-ad Telegram messages.
# The daily send_alerts command always runs as a backfill regardless of this setting.
IMMEDIATE_ALERTS_ENABLED=false

# ====================== TLS Certificates (production nginx) ======================
# Mount point for TLS certificates (fullchain.pem / privkey.pem)
TLS_CERT_PATH=/etc/nginx/certs

# ====================== Analytics ======================
# Plausible host (cookieless, no consent banner needed); empty to disable.
PLAUSIBLE_HOST=

# ====================== Django Admin User (for site management) ======================
# Note: Admin login uses the `username` field (not telegram_id) via Django's standard
# admin authentication form. The username defaults to "admin" (or ADMIN_USERNAME) and
# the password comes from ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=  # Set in production via secret management
ADMIN_TELEGRAM_ID=-1  # Placeholder ID for admin users (negative to avoid collision with real Telegram IDs)

# ====================== Seed (demo data, optional seed service) ======================
SEED_USERS=10
SEED_ADS=30

# ====================== Production image / registry (docker-compose.prod.yml) ======================
# Pull pre-built GHCR images instead of building locally. Leave defaults to build locally.
REGISTRY=ghcr.io
REPOSITORY=manicko/mko_bazuna
IMAGE_TAG=latest

# ====================== Container runtime (docker/entrypoint.sh) ======================
# Set FIX_PERMISSIONS=1 to force media-volume permission fixes (auto-on when DEBUG=True).
FIX_PERMISSIONS=0
# Set SKIP_ENV_CHECK=1 to skip the "missing .env file" fail-fast check (used by the test compose).
SKIP_ENV_CHECK=

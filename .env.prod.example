# .env.prod — Production environment variables
# Used by Docker Compose for production (`docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml ...`)
# Bind-mounted into containers as /app/src/.env (via Docker Compose volume mount)
#
# DO NOT include DATABASE_URL — Docker Compose constructs it from POSTGRES_* vars.
# The POSTGRES_* values below use the inter-container hostname `db`.
#
# NEVER commit this file to git. Use .env.prod.example as the template.

# ====================== Django ======================
# Generate a secure key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NOTE: Single-quote the value so Docker Compose does NOT interpolate "$VAR".
DJANGO_SECRET_KEY=<generate-with-django-secret-key-generator>
DEBUG=False
ALLOWED_HOSTS=<your-production-domain.com>,www.<your-production-domain.com>
CSRF_TRUSTED_ORIGINS=https://mko-bazuna.example.com

# ====================== PostgreSQL Database ======================
# Compose constructs DATABASE_URL from POSTGRES_* ? postgres://user:pass@db:5432/db
POSTGRES_USER=bazuna_user
POSTGRES_DB=bazuna_db
POSTGRES_PASSWORD=<your-secure-production-password>
POSTGRES_HOST=db

# ====================== Redis ======================
REDIS_URL=redis://redis:6379/0

# ====================== Telegram Bot ======================
# Bot username for contact deep-links (without @)
BOT_USERNAME=<your-bot-username>

# HMAC key for the Telegram-ID log mask (mask_telegram_id). REQUIRED in
# production; the prod.py guard rejects this placeholder. Generate one with
# `python -c "import secrets; print(secrets.token_hex(32))"`.
LOG_MASK_KEY=<generate-a-random-32-byte-log-mask-key>

# Get your bot token from @BotFather. REQUIRED in production.
BOT_TOKEN=<your-bot-token-from-botfather>

# ====================== Email / SMTP ======================
# REQUIRED in production — used for the Telegram support-ticket notification
# email, the only transactional email the application sends. Configure your SMTP
# provider (e.g. SendGrid, Mailgun, AWS SES) and set EMAIL_HOST to their SMTP
# endpoint.
EMAIL_HOST=<your-smtp-host>
EMAIL_PORT=587
EMAIL_HOST_USER=<your-smtp-username>
EMAIL_HOST_PASSWORD=<your-smtp-password>
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL= noreply@<your-production-domain.com>
# Required for support notifications. Comma-separated list of admin email
# addresses that support notifications are delivered to.
SUPPORT_NOTIFICATION_RECIPIENTS=<your-support-recipient-email@example.com>

# ====================== Google Cloud Translation API ======================
# Required in production for ad content translation.
# Get a key at: https://console.cloud.google.com/apis/credentials
# Free tier: 500,000 chars/month; overages $20/1M chars.
GOOGLE_TRANSLATE_API_KEY=<your-google-cloud-translation-api-key>

# ====================== Public site ======================
# REQUIRED in production — no trailing slash. Example: https://mko-bazuna.example.com
SITE_URL=https://mko-bazuna.example.com

# Near-real-time publish-time alert delivery (Telegram).
IMMEDIATE_ALERTS_ENABLED=false

# ====================== Database lock timeout ======================
# Seconds any statement waits for a row/table/advisory lock before failing
# (03-DB-004). Applies to both web and bot processes. Valid range 0..2147483647;
# 0 disables the bound and is the only disabling value. A negative value is
# clamped to 0 (PostgreSQL would otherwise FATAL every process at boot).
LOCK_TIMEOUT_SECONDS=10

# ====================== TLS Certificates (nginx) ======================
# DEFERRED DECISION (09-API-016): the host certificate path is not yet decided —
# the production host filesystem and the CI-runner filesystem are not visible
# from this repository, so only the owner can name the real path. The candidate
# namespaced path is `deploy/secrets/mko_bazuna.crt` (a bare filename such as
# `mko_bazuna.crt` is ambiguous). This default is deliberately left unchanged
# until the owner rules; do not treat it as a decided path. Docker auto-creates a
# missing bind-mount source as an EMPTY directory, so a forgotten export does not
# fail at mount time — nginx starts and then aborts loading the certificate.
TLS_CERT_PATH=/etc/nginx/certs

# ====================== Analytics ======================
PLAUSIBLE_HOST=

# ====================== Error Tracking (Sentry) ======================
# Optional Sentry DSN for crash reporting. Leave empty to disable.
# Get a DSN at: https://sentry.io/organization/your-org/projects/
SENTRY_DSN=

# ====================== Admin User ======================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<your-secure-admin-password>
ADMIN_TELEGRAM_ID=-1

# ====================== Container image (docker-compose.prod.yml) ======================
# IMAGE_TAG is REQUIRED: docker-compose.prod.yml uses ${IMAGE_TAG:?...}, so a
# missing value fails `docker compose up` loudly instead of silently pulling
# `:latest`. The value below is a concrete pinned tag, NOT `latest` — a floating
# default let two hosts running the same file drift to different code. The deploy
# job (.github/workflows/deploy.yml) overrides it with the CI commit SHA and only
# pulls; it never builds (09-API-016).
REGISTRY=ghcr.io
REPOSITORY=manicko/mko_bazuna
IMAGE_TAG=2026.10.03

# ====================== Container runtime ======================
FIX_PERMISSIONS=0
SKIP_ENV_CHECK=

# ====================== Migration bootstrap ======================
# One-shot operator action for the `migrate` service. Set to exactly "true" to
# append the optional `backfill_translations` step to the bootstrap sequence; the
# step runs inside the same advisory lock as migrate / setup_search_triggers /
# load_exchange_rates. Unset it again after the run -- this is a one-time
# backfill, not a standing setting.
# See docs/ops/migration-workflow.md.
# RUN_TRANSLATION_BACKFILL=true

# ====================== Prometheus Metrics (multiprocess mode) ======================
# Required for accurate multi-worker metrics collection under gunicorn.
# The directory is mounted as tmpfs (ephemeral, writable by appuser).
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

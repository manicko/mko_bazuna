# .env.docker — Environment variables for Docker deployment
# Used by docker-compose.yml for all services
# DO NOT include DATABASE_URL - Docker Compose constructs it from POSTGRES_* variables

# Django
DJANGO_SECRET_KEY=<generate-with-django-secret-key-generator>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database (used by Docker Compose to build DATABASE_URL)
POSTGRES_USER=bazuna_user
POSTGRES_DB=bazuna_db
POSTGRES_PASSWORD=your-password

# Telegram Bot
BOT_USERNAME=bazuna_bot
# BOT_TOKEN: Set a real token from @BotFather, or leave empty to disable bot in dev
BOT_TOKEN=

# TLS Certificates
TLS_CERT_PATH=/etc/nginx/certs

# Analytics
PLAUSIBLE_HOST=

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=-1
# .env.docker.example - Template environment variables for Docker deployment
# Copy to a gitignored runtime file before deploying: cp .env.docker.example .env.docker
# docker-compose.yml and Makefile load the runtime file .env.docker (NOT this template)
# DO NOT include DATABASE_URL - Docker Compose constructs it from POSTGRES_* variables

# Django
DJANGO_SECRET_KEY=<generate-with-django-secret-key-generator>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database (used by Docker Compose to build DATABASE_URL)
POSTGRES_USER=bazuna_user
POSTGRES_DB=bazuna_db
POSTGRES_PASSWORD=your-password

# Redis (cache backend — required for rate limiting and shared cache across web/bot processes)
REDIS_URL=redis://redis:6379/0

# Telegram Bot
BOT_USERNAME=bazuna_bot
# BOT_TOKEN: Set a real token from @BotFather, or leave empty to disable bot in dev
BOT_TOKEN=

# TLS Certificates
TLS_CERT_PATH=/etc/nginx/certs

# Analytics
PLAUSIBLE_HOST=

# Public site URL used for absolute links (e.g. Telegram alert messages).
# Required in production. No trailing slash. Example: https://mko-bazuna.example.com
SITE_URL=https://mko-bazuna.example.com

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=-1
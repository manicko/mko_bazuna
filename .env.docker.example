# .env.docker.example - Template environment variables for Docker deployment
# Copy to a gitignored runtime file before deploying: cp .env.docker.example .env.docker
# docker-compose.yml and Makefile load the runtime file .env.docker (NOT this template)
# DO NOT include DATABASE_URL - Docker Compose constructs it from POSTGRES_* variables

# ====================== Django ======================
# Generate a secure key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<generate-with-django-secret-key-generator>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ====================== PostgreSQL Database ======================
# Used by Docker Compose to build DATABASE_URL (format: postgres://user:pass@db:5432/db)
POSTGRES_USER=bazuna_user
POSTGRES_DB=bazuna_db
POSTGRES_PASSWORD=your-password

# ====================== Redis ======================
# Cache backend — required for rate limiting and shared cache across web/bot processes.
# In Docker the value is normally redis://redis:6379/0 (compose service name).
REDIS_URL=redis://redis:6379/0

# ====================== Telegram Bot ======================
BOT_USERNAME=bazuna_bot
# BOT_TOKEN: real token from @BotFather, or leave empty to disable the bot in dev.
# Required (non-empty) in production — the config.settings.prod guard fails otherwise.
BOT_TOKEN=

# ====================== Public site ======================
# Site URL used for absolute links (e.g. Telegram alert messages).
# Required in production (a guard fails without it under config.settings.prod).
# No trailing slash. Example: https://mko-bazuna.example.com
SITE_URL=https://mko-bazuna.example.com

# Near-real-time publish-time alert delivery (Telegram). Default OFF for safe rollout.
# When ON, newly published ads trigger immediate per-ad Telegram messages.
# The daily send_alerts scheduler job always runs as a backfill regardless of this setting.
IMMEDIATE_ALERTS_ENABLED=false

# ====================== TLS Certificates (production nginx) ======================
# Mount point for TLS certificates (fullchain.pem / privkey.pem)
TLS_CERT_PATH=/etc/nginx/certs

# ====================== Analytics ======================
# Plausible host (cookieless, no consent banner needed); empty to disable.
PLAUSIBLE_HOST=

# ====================== Admin ======================
# Django admin/superuser created by the create_admin one-shot service.
# create_admin is skipped when ADMIN_PASSWORD is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=-1

# ====================== Seed (demo data) ======================
# Only used by the optional seed service (seed/--profile seed).
SEED_USERS=10
SEED_ADS=600

# ====================== Production image / registry (docker-compose.prod.yml) ======================
# Used to override web/bot/migrate/create_admin/seed to pull pre-built GHCR images.
# Leave at defaults to build locally instead of pulling.
REGISTRY=ghcr.io
REPOSITORY=manicko/mko_bazuna
IMAGE_TAG=latest

# ====================== Container runtime (entrypoint.sh) ======================
# Set FIX_PERMISSIONS=1 to force media-volume permission fixes (already auto-on when DEBUG=True).
FIX_PERMISSIONS=0
# Set SKIP_ENV_CHECK=1 to skip the "missing .env file" fail-fast check
# (used internally by the test compose; normally leave empty).
SKIP_ENV_CHECK=

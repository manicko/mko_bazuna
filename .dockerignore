# Local virtual environments (uv, venv, poetry, etc.)
.venv
venv
env
.env*

# Python cache and temporary files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Local data and media
media/
staticfiles/

# Local databases — must not be baked into container images
*.sqlite3
*.sqlite
*.db
src/backend/mko_bazuna

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# Logs and temp
*.log

# uv cache
.uv/
.cache/

# Git and CI
.git/
.github/
.gitignore

# Git worktrees — exclude from build context so compilemessages (Dockerfile :78)
# only compiles the current branch's locale files, not stale worktree .po files
.kilo/

# Documentation — not needed in runtime image
docs/
*.md

# Docker compose files — not needed in build context (root only)
/Dockerfile*
/docker-compose*

# Ruff and mypy cache
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Node.js (if present in context)
node_modules/

# Seed photo API keys — gitignored but must also be dockerignored
scripts/seed-images-config.json

# Local database backups — may contain PII from `make backup`
backups/
# Stray debug/profiling artifacts (git-tracked, but must not enter build context)
cat_output.txt
neq
Continue
cmp_css.py

# Local pipx/pyenv user installs
.local/

# Test profiling temp files (git-tracked — also gitignored via F05)
scripts/_tmp_pytest_run.txt
scripts/_tmp_pytest_out.txt
scripts/session_context.json

# Playwright MCP browser/runtime artifacts
.playwright-mcp/

# Nginx configs — bind-mounted at runtime, never needed in build context
docker/nginx/

# Compiled translations — stale .mo files may be baked in if compilemessages fails
*.mo
*.pot

# Git config — irrelevant inside container
.gitattributes

# Python version pin — consumed by pyenv locally, base image provides Python
.python-version

# Python tool cache directories (defense-in-depth for local dev artifacts)
.tox/
.nox/
.pyre/
.pytype/
__pypackages__/
.profile_default/
.pdbrc
.python-eggs/

# PyInstaller artifacts (defensive — may appear from builds)
*.manifest
*.spec

# Test/coverage artifacts — test execution metadata should not be in images
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Runtime state — PID files, Redis persistence, Gunicorn runtime state
celerybeat-schedule
celerybeat.pid
*.rdb
*.aof
*.pid
.gunicorn/
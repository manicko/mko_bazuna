import json

files = [
    r'C:\py_dev\mko_bazuna\src\backend\apps\seed\fixtures\ads_templates.transport.json',
    r'C:\py_dev\mko_bazuna\src\backend\apps\seed\fixtures\images\query_hierarchy.transport.json',
    r'C:\py_dev\mko_bazuna\src\backend\apps\seed\fixtures\word_lists.transport.json'
]

for f in files:
    try:
        with open(f, encoding='utf-8') as fh:
            d = json.load(fh)
        name = f.split('\\')[-1]
        print(f'VALID JSON: {name}', end='')
        if 'templates' in d:
            slugs = sorted(set(t['category_slug'] for t in d['templates']))
            print(f' - {len(d["templates"])} templates, {len(slugs)} slugs')
        elif 'brands' in d:
            ns = len(d['brands']['transport']['ru'])
            nfs = len(d['features'])
            print(f' - version={d["version"]}, brands={ns}, feature slugs={nfs}')
            for k in sorted(d['features']):
                flen = len(d['features'][k]['ru'])
                elen = len(d['features'][k]['en'])
                blen = len(d['features'][k]['bs'])
                status = 'OK' if min(flen,elen,blen) >= 10 else 'WARNING'
                print(f'  {k}: ru={flen} en={elen} bs={blen} [{status}]')
        else:
            print(f' - {len(d)} slugs')
            for k in d:
                obj = len(d[k].get('objects', []))
                ctx = len(d[k].get('contexts', []))
                sty = len(d[k].get('styles', []))
                ok = all([obj >= 5, ctx >= 5, sty >= 3])
                status = 'OK' if ok else f'ISSUE: o={obj} c={ctx} s={sty}'
                print(f'  {k}: objects={obj} contexts={ctx} styles={sty} [{status}]')
    except Exception as e:
        print(f'ERROR: {f.split(chr(92))[-1]}: {e}')
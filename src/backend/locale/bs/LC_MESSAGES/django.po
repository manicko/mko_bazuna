msgstr "Namjena"

msgid "Consent-Gated"
msgstr "Zahteva pristanak"

msgid "Authentication session"
msgstr "Sesija autentifikacije"

msgid "Yes"
msgstr "Da"

msgid "No"
msgstr "Ne"

msgid "Cross-Site Request Forgery protection"
msgstr "Zaštita od cross-site request forgery (CSRF)"

msgid "Consent state (accepted / declined / withdrawn)"
msgstr "Stanje pristanka (prihvaćen / odbijen / povučen)"

msgid "N/A (consent state itself)"
msgstr "N/A (samo stanje pristanka)"

msgid "Analytics consent state"
msgstr "Stanje pristanka na analitiku"

msgid "Preferences consent state"
msgstr "Stanje pristanka na postavke"

msgid "Preferred language (UI)"
msgstr "Preferirani jezik (interfejs)"

msgid "Yes (preferences)"
msgstr "Da (postavke)"

